---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/url';
import { formatDate } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const socialImage = new URL(href(`og/${post.id}.png`), Astro.site).toString();
const wordCount = post.body.match(/[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu)?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const readingTime = `${readingMinutes} min read`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={socialImage}
  imageAlt={`Social preview for “${post.data.title}”`}
  wide={toc.length > 0}
>
  <div class="reading-progress" data-reading-progress data-reading-minutes={readingMinutes}>
    <div class="reading-progress-inner">
      <span>{readingTime}</span>
      <span data-reading-remaining>{readingMinutes} min left</span>
      <div
        class="reading-progress-track"
        role="progressbar"
        aria-label="Article reading progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <span class="reading-progress-fill"></span>
      </div>
    </div>
  </div>
  <article class={toc.length > 0 ? 'post-layout' : undefined} data-reading-article>
    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <p class="toc-title"><span aria-hidden="true"></span> On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'd3' : undefined}>
                <a href={`#${h.slug}`}>{h.text.replace(/[$`]/g, '')}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="prose">
      <header class="post-header">
        <p class="post-kicker">Engineering note</p>
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="post-dek">{post.data.description}</p>}
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.tags.length > 0 && <span class="meta-rule" aria-hidden="true"></span>}
          <div class="post-tags">
            {post.data.tags.map((tag) => <a href={href(`tags/${tag}`)}>{tag}</a>)}
          </div>
        </div>
      </header>
      <Content />
    </div>
  </article>
  <script>
    import '../../lib/reading-progress.js';
  </script>
</Base>
