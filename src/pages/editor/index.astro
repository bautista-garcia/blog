---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import 'katex/dist/katex.min.css';
import '../../styles/global.css';
import '../../editor/editor.css';
import { site } from '../../site.config';
import { href } from '../../lib/url';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3f0e9" />
    <title>Writing studio · {site.name}</title>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body class="editor-body">
    <div
      id="editor"
      data-owner={site.repo.owner}
      data-repo={site.repo.name}
      data-branch={site.repo.branch}
      data-base={base}
    >
      <section id="gate" hidden aria-labelledby="gate-title">
        <div class="gate-panel">
          <a class="gate-home" href={base} aria-label={`Back to ${site.name}`}>
            <span class="brand-mark" aria-hidden="true">B</span>
            <span>{site.name}</span>
          </a>
          <div class="gate-copy">
            <p class="eyebrow">Private writing studio</p>
            <h1 id="gate-title">Write in the browser.<br />Publish with a commit.</h1>
            <p>
              Draft, preview, and publish without leaving your blog. Your token remains in this
              browser and is sent only to GitHub.
            </p>
          </div>
          <form id="gate-form" class="gate-form">
            <div class="field-pair">
              <label>
                <span>Repository owner</span>
                <input id="gate-owner" autocomplete="off" required />
              </label>
              <label>
                <span>Repository</span>
                <input id="gate-repo" autocomplete="off" required />
              </label>
            </div>
            <label>
              <span>GitHub personal access token</span>
              <input id="gate-token" type="password" autocomplete="off" required />
            </label>
            <button id="gate-save" class="button primary large" type="submit">Open the studio</button>
            <p id="gate-error" class="form-message" role="alert"></p>
          </form>
          <p class="gate-help">
            Use a fine-grained token for this repository with <strong>Contents: read and write</strong>.
            <a href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener">
              Create a token ↗
            </a>
          </p>
        </div>
        <aside class="gate-aside" aria-label="Editor features">
          <div class="gate-preview" aria-hidden="true">
            <span class="preview-kicker">DRAFT · 4 MIN READ</span>
            <span class="preview-title">An idea, clearly expressed.</span>
            <span class="preview-line long"></span>
            <span class="preview-line"></span>
            <span class="preview-line short"></span>
            <span class="preview-heading">A thoughtful section</span>
            <span class="preview-line long"></span>
            <span class="preview-line"></span>
          </div>
          <ul>
            <li><span>01</span> GitHub-backed publishing</li>
            <li><span>02</span> Live Markdown + math preview</li>
            <li><span>03</span> Local recovery and history</li>
          </ul>
        </aside>
      </section>

      <div id="app" hidden>
        <header id="topbar">
          <div class="topbar-left">
            <button id="btn-sidebar" class="icon-button mobile-only" type="button" aria-label="Toggle post library">☰</button>
            <a class="app-brand" href={base} aria-label={`Back to ${site.name}`}>
              <span class="brand-mark small" aria-hidden="true">B</span>
              <span>Studio</span>
            </a>
            <span class="topbar-divider" aria-hidden="true"></span>
            <span id="current-label" class="current-label">Untitled</span>
          </div>
          <div class="topbar-right">
            <span id="status" class="status-message" role="status" aria-live="polite"></span>
            <button id="btn-command" class="button command-button" type="button" aria-label="Open command menu">
              Commands <kbd>⌘ K</kbd>
            </button>
            <button id="btn-theme" class="icon-button" type="button" aria-label="Toggle theme">◐</button>
            <button id="btn-save" class="button primary save-button" type="button">
              <span>Publish changes</span><kbd>⌘ S</kbd>
            </button>
          </div>
        </header>

        <div id="main">
          <aside id="sidebar" aria-label="Post library">
            <div class="library-head">
              <div>
                <p class="eyebrow">Library</p>
                <h2>Posts <span id="post-count">0</span></h2>
              </div>
              <button id="btn-new" class="icon-button filled" type="button" aria-label="New post">＋</button>
            </div>
            <label class="search-field">
              <span aria-hidden="true">⌕</span>
              <input id="post-search" type="search" placeholder="Search posts" autocomplete="off" />
              <kbd>⌘ /</kbd>
            </label>
            <div id="post-filters" class="filter-tabs" role="tablist" aria-label="Filter posts">
              <button class="active" data-filter="all" type="button" role="tab" aria-selected="true">All</button>
              <button data-filter="published" type="button" role="tab" aria-selected="false">Published</button>
              <button data-filter="draft" type="button" role="tab" aria-selected="false">Drafts</button>
            </div>
            <ul id="post-list" class="post-list"></ul>
            <div class="library-foot">
              <span class="connection-dot" aria-hidden="true"></span>
              <span id="repo-label">{site.repo.owner}/{site.repo.name}</span>
              <span>· {site.repo.branch}</span>
              <button id="btn-refresh" type="button">Refresh</button>
            </div>
          </aside>
          <button id="sidebar-scrim" type="button" aria-label="Close post library" hidden></button>

          <main id="workspace">
            <section id="document-head" aria-label="Post details">
              <input id="f-title" class="title-input" placeholder="Untitled post" autocomplete="off" />
              <input
                id="f-desc"
                class="description-input"
                placeholder="Add a one-line description (optional)"
                autocomplete="off"
              />
              <div class="metadata-row">
                <label class="tags-field">
                  <span>Tags</span>
                  <input id="f-tags" placeholder="Add tags, separated by commas" autocomplete="off" />
                </label>
                <details id="properties-menu" class="properties-menu">
                  <summary>Post settings <span aria-hidden="true">⌄</span></summary>
                  <div class="properties-card">
                    <label>
                      <span>Slug</span>
                      <input id="f-slug" autocomplete="off" />
                    </label>
                    <label>
                      <span>Publish date</span>
                      <input id="f-date" type="date" />
                    </label>
                    <label class="toggle-field">
                      <span><strong>Draft</strong><small>Hide this post from production</small></span>
                      <input id="f-draft" type="checkbox" />
                    </label>
                    <label>
                      <span>Additional frontmatter</span>
                      <textarea id="f-extra" rows="4" placeholder="canonical: https://…"></textarea>
                    </label>
                  </div>
                </details>
              </div>
            </section>

            <div id="toolbar" role="toolbar" aria-label="Markdown formatting">
              <div class="tool-group history-tools">
                <button data-command="undo" type="button" aria-label="Undo" title="Undo">↶</button>
                <button data-command="redo" type="button" aria-label="Redo" title="Redo">↷</button>
              </div>
              <span class="tool-divider" aria-hidden="true"></span>
              <select id="heading-select" aria-label="Text style" title="Text style">
                <option value="paragraph">Paragraph</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
              </select>
              <div class="tool-group">
                <button data-command="bold" type="button" aria-label="Bold" title="Bold (⌘B)"><strong>B</strong></button>
                <button data-command="italic" type="button" aria-label="Italic" title="Italic (⌘I)"><em>I</em></button>
                <button data-command="strike" type="button" aria-label="Strikethrough" title="Strikethrough"><s>S</s></button>
                <button data-command="link" type="button" aria-label="Link" title="Insert link">Link</button>
                <button data-command="inlineCode" type="button" aria-label="Inline code" title="Inline code">&lt;/&gt;</button>
              </div>
              <span class="tool-divider" aria-hidden="true"></span>
              <div class="tool-group secondary-tools">
                <button data-command="bullet" type="button" aria-label="Bullet list" title="Bullet list">• List</button>
                <button data-command="ordered" type="button" aria-label="Numbered list" title="Numbered list">1. List</button>
                <button data-command="checklist" type="button" aria-label="Checklist" title="Checklist">☑</button>
                <button data-command="quote" type="button" aria-label="Block quote" title="Block quote">❝</button>
                <button data-command="codeblock" type="button" aria-label="Code block" title="Code block">Code</button>
              </div>
              <details class="insert-menu">
                <summary class="toolbar-summary">Insert <span aria-hidden="true">⌄</span></summary>
                <div class="menu-card">
                  <button data-command="image" type="button" aria-label="Insert image"><span>Image</span><small>Paste, drop, or upload</small></button>
                  <button data-command="diagram" type="button" aria-label="Insert Excalidraw diagram"><span>Excalidraw diagram</span><small>SVG with embedded scene</small></button>
                  <button data-command="table" type="button" aria-label="Insert table"><span>Table</span><small>GitHub-flavored Markdown</small></button>
                  <button data-command="math" type="button" aria-label="Insert equation"><span>Equation</span><small>Inline or display KaTeX</small></button>
                  <button data-command="sidenote" type="button" aria-label="Insert sidenote"><span>Sidenote</span><small>Note in the page margin</small></button>
                  <button data-command="footnote" type="button" aria-label="Insert footnote"><span>Footnote</span><small>Reference and definition</small></button>
                  <button data-command="horizontalRule" type="button" aria-label="Insert divider"><span>Divider</span><small>Horizontal rule</small></button>
                </div>
              </details>
              <span class="toolbar-spacer"></span>
              <div id="view-switcher" class="view-switcher" aria-label="Editor view">
                <button data-view="write" type="button">Write</button>
                <button data-view="split" type="button" class="active">Split</button>
                <button data-view="preview" type="button">Preview</button>
              </div>
              <button id="btn-focus" class="focus-button" type="button" title="Focus mode" aria-label="Focus mode">↗</button>
              <details id="more-menu" class="more-menu">
                <summary class="icon-button" aria-label="More actions">•••</summary>
                <div class="menu-card align-right">
                  <button id="btn-import" type="button" aria-label="Import Markdown"><span>Import Markdown</span><kbd>MD</kbd></button>
                  <button id="btn-export" type="button" aria-label="Export Markdown"><span>Export Markdown</span><kbd>↓</kbd></button>
                  <button id="btn-history" type="button" aria-label="Version history"><span>Version history</span><kbd>↶</kbd></button>
                  <button id="btn-shortcuts" type="button" aria-label="Keyboard shortcuts"><span>Keyboard shortcuts</span><kbd>⌘</kbd></button>
                  <button id="btn-delete" class="danger" type="button" aria-label="Delete post" hidden><span>Delete post</span></button>
                  <button id="btn-forget" type="button" aria-label="Disconnect GitHub"><span>Disconnect GitHub</span></button>
                </div>
              </details>
            </div>

            <div id="panes" data-mode="split">
              <section id="source-pane" aria-label="Markdown source">
                <div id="editor-host"></div>
                <div id="drop-indicator" aria-hidden="true">Drop an image to insert it</div>
              </section>
              <section id="preview-pane" aria-label="Rendered preview">
                <article id="preview" class="prose"></article>
              </section>
              <aside id="outline-pane" aria-label="Document outline">
                <div class="outline-head">
                  <span>Outline</span>
                  <span id="outline-count"></span>
                </div>
                <nav id="outline"></nav>
              </aside>
            </div>

            <footer id="statusbar">
              <div class="status-left">
                <span id="save-state" data-state="saved"><i></i> Synced with GitHub</span>
                <span id="local-state"></span>
              </div>
              <div class="writing-stats">
                <span id="selection-count" hidden></span>
                <span id="word-count">0 words</span>
                <span id="read-time">1 min read</span>
                <span id="character-count">0 characters</span>
                <span>Markdown</span>
              </div>
            </footer>
          </main>
        </div>
      </div>

      <dialog id="asset-dialog" class="editor-dialog">
        <form id="asset-form" method="dialog">
          <div class="dialog-head">
            <div>
              <p class="eyebrow">Media library</p>
              <h2 id="asset-title">Insert image</h2>
            </div>
            <button class="dialog-close" type="button" data-close-dialog="asset-dialog" aria-label="Close">×</button>
          </div>
          <p id="asset-hint" class="dialog-intro"></p>
          <a id="asset-excalidraw" href="https://excalidraw.com" target="_blank" rel="noopener" hidden>
            Open Excalidraw ↗
          </a>
          <label id="asset-drop" class="dropzone">
            <span class="drop-icon" aria-hidden="true">↑</span>
            <strong>Drop a file here</strong>
            <span>or choose one from your computer</span>
            <input id="asset-file" type="file" accept="image/*,.svg" hidden />
          </label>
          <div id="asset-preview" class="asset-preview" hidden></div>
          <div class="field-grid">
            <label class="span-two"><span>File name</span><input id="asset-name" autocomplete="off" /></label>
            <label><span>Alt text</span><input id="asset-alt" autocomplete="off" /></label>
            <label><span>Width in pixels</span><input id="asset-width" type="number" min="50" placeholder="Auto" /></label>
            <label class="span-two"><span>Caption</span><input id="asset-caption" autocomplete="off" placeholder="Optional" /></label>
          </div>
          <p id="asset-error" class="form-message" role="alert"></p>
          <div class="dialog-actions">
            <button class="button" type="button" data-close-dialog="asset-dialog">Cancel</button>
            <button id="asset-insert" class="button primary" type="submit" disabled>Upload and insert</button>
          </div>
        </form>
      </dialog>

      <dialog id="import-dialog" class="editor-dialog wide-dialog">
        <form id="import-form" method="dialog">
          <div class="dialog-head">
            <div>
              <p class="eyebrow">Bring your work</p>
              <h2>Import from Markdown or Obsidian</h2>
            </div>
            <button class="dialog-close" type="button" data-close-dialog="import-dialog" aria-label="Close">×</button>
          </div>
          <p class="dialog-intro">
            Add one Markdown file and any images it references. Obsidian embeds and wikilinks are
            converted automatically; matched images upload with the post.
          </p>
          <label id="import-drop" class="dropzone large-dropzone">
            <span class="drop-icon" aria-hidden="true">＋</span>
            <strong>Drop your note and images together</strong>
            <span>.md, .markdown, PNG, JPG, GIF, WebP, or SVG</span>
            <input id="import-files" type="file" multiple hidden />
          </label>
          <p id="import-status" class="import-status"></p>
          <ul id="import-missing" class="missing-list"></ul>
          <p id="import-error" class="form-message" role="alert"></p>
          <div class="dialog-actions">
            <button class="button" type="button" data-close-dialog="import-dialog">Cancel</button>
            <button id="import-go" class="button primary" type="submit" disabled>Import post</button>
          </div>
        </form>
      </dialog>

      <dialog id="command-dialog" class="command-dialog">
        <div class="command-search">
          <span aria-hidden="true">⌕</span>
          <input id="command-search" placeholder="Type a command or search…" autocomplete="off" />
          <kbd>Esc</kbd>
        </div>
        <div id="command-list" class="command-list" role="listbox"></div>
      </dialog>

      <dialog id="history-dialog" class="editor-dialog history-dialog">
        <div class="dialog-head">
          <div>
            <p class="eyebrow">Git history</p>
            <h2>Version history</h2>
          </div>
          <button class="dialog-close" type="button" data-close-dialog="history-dialog" aria-label="Close">×</button>
        </div>
        <p class="dialog-intro">Restore any earlier version into the editor, then publish when you are ready.</p>
        <div id="history-list" class="history-list"></div>
      </dialog>

      <dialog id="shortcuts-dialog" class="editor-dialog shortcuts-dialog">
        <div class="dialog-head">
          <div><p class="eyebrow">Work faster</p><h2>Keyboard shortcuts</h2></div>
          <button class="dialog-close" type="button" data-close-dialog="shortcuts-dialog" aria-label="Close">×</button>
        </div>
        <dl class="shortcut-list">
          <div><dt>Save to GitHub</dt><dd><kbd>⌘ S</kbd></dd></div>
          <div><dt>Command menu</dt><dd><kbd>⌘ K</kbd></dd></div>
          <div><dt>Search or replace</dt><dd><kbd>⌘ F</kbd></dd></div>
          <div><dt>Bold / Italic</dt><dd><kbd>⌘ B</kbd> <kbd>⌘ I</kbd></dd></div>
          <div><dt>Undo / Redo</dt><dd><kbd>⌘ Z</kbd> <kbd>⌘ ⇧ Z</kbd></dd></div>
          <div><dt>Indent / Outdent</dt><dd><kbd>Tab</kbd> <kbd>⇧ Tab</kbd></dd></div>
        </dl>
      </dialog>
    </div>

    <script>
      import '../../editor/app.js';
      import '../../lib/lightbox.js';
    </script>
  </body>
</html>
