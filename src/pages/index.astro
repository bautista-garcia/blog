---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import { formatDate } from '../lib/date';
import { getExcerpt } from '../lib/excerpt';

const posts = (
  await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <section class="writing-index home-writing-index" aria-labelledby="latest-writing">
    <header class="section-head">
      <div>
        <p class="eyebrow">Archive</p>
        <h2 id="latest-writing">Latest writing</h2>
      </div>
      <p>{posts.length} {posts.length === 1 ? 'blog' : 'blogs'}</p>
    </header>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              {post.data.tags.length > 0 && (
                <span class="tags">
                  {post.data.tags.map((tag) => (
                    <a href={href(`tags/${tag}`)}>{tag}</a>
                  ))}
                </span>
              )}
            </div>
            <div class="post-summary">
              <h3>
                <a href={href(`posts/${post.id}`)}>
                  <span>
                    {post.data.title}
                    {post.data.draft && <span class="draft-badge">Draft</span>}
                  </span>
                  <span class="post-arrow" aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{post.data.description ?? getExcerpt(post.body ?? '')}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
